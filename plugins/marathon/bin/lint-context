#!/usr/bin/env python3
"""Check a marathon repository's context at the current working directory.

Every file under context/ is of a known kind: the context README, a note, a
goal record, the roadmap index, or a goal file. Notes, READMEs, goal-record
sections, and roadmap entries stay within fixed word budgets, where a word is a
whitespace-separated token, as wc -w counts it. The roadmap keeps the shape
marathon's references/manifest.md gives it. The context README's capability
map lists each feature as built or planned, and every relative markdown link in
the root README, context/, and docs/ resolves. Prints one line per failure and
exits nonzero if there is any.
"""

import re
import sys
import tomllib
from pathlib import Path
from urllib.parse import unquote

CONTEXT_README_BUDGET = 1000
ROOT_README_BUDGET = 1500
NOTE_BUDGET = 1500
RECORD_SECTION_BUDGETS = (
    ("## Task brief", 1200, "shorten"),
    ("## Decisions", 2000, "prune what no longer binds later tasks"),
    ("## Pending edits", 1000, "apply or shorten"),
)
PROSE_FIX = "trim; move detail to docs/"
INDEX_ARRAYS = ("active", "planned", "backlog")
INDEX_COMMENT_LINES = 2
GOAL_ENTRY_BUDGETS = (("summary", 100),)
TASK_ENTRY_BUDGETS = (("summary", 100), ("proof", 40))
CRITERION_BUDGET = 60
ENTRY_FIX = "move detail to the goal's context note"
PARSE_ERRORS = (tomllib.TOMLDecodeError, UnicodeDecodeError)
RECORD_TASK = re.compile(r"\d+\. \[[ x]\] (\S+)$")
CAPABILITY_MAP = "## Capability map"
CAPABILITY_ENTRY = re.compile(r"- \*\*(.+?)\*\* \((built|planned)\): \S")
CAPABILITY_NAME = re.compile(r"- \*\*(.+?)\*\*")
ENTRY_FORM = "open it as '- **Name** (built): text' or '- **Name** (planned): text'"
FENCE = re.compile(r"\s*(`{3,}|~{3,})")
CODE_SPAN = re.compile(r"(`+)(?!`).*?(?<!`)\1(?!`)")
LINK_TITLE = r"""(?:\s+(?:"[^"]*"|'[^']*'|\([^)]*\)))?"""
INLINE_LINK = re.compile(r"\]\(\s*(<[^>]*>|[^\s)]*)" + LINK_TITLE + r"\s*\)")
LINK_DEFINITION = re.compile(r" {0,3}\[(?!\^)[^\]]+\]:\s*(<[^>]*>|\S+)")
URL_SCHEME = re.compile(r"[A-Za-z][A-Za-z0-9+.-]*:")


def words(text):
    return len(text.split())


def over(path, kind, count, budget, fix):
    return f"{path}: {kind} is {count:,} words, budget {budget:,}; {fix}"


def classify(rel):
    """Returns the kind of a path relative to the root, or None if it has none."""
    parts = rel.parts
    if parts == ("context", "README.md"):
        return "context-readme"
    if parts == ("context", "roadmap.toml"):
        return "roadmap-index"
    if len(parts) == 2 and rel.suffix == ".md":
        return "note"
    if len(parts) == 3 and parts[1] == "goals" and rel.suffix == ".md":
        return "record"
    if len(parts) == 3 and parts[1] == "roadmap" and rel.suffix == ".toml":
        return "goal-file"
    return None


def read(path):
    return path.read_text(encoding="utf-8")


def tree_files(root, top, pattern="*"):
    """Yields each file under top matching pattern, relative to root.

    Dotfiles and dot directories are skipped.
    """
    if not (root / top).is_dir():
        return
    for path in sorted((root / top).rglob(pattern)):
        rel = path.relative_to(root)
        if path.is_file() and not any(part.startswith(".") for part in rel.parts):
            yield rel


def record_sections(text):
    """Yields (heading, body) for each ## section; the heading is not in the body."""
    heading, body = None, []
    for line in text.splitlines():
        if line.startswith("## "):
            if heading is not None:
                yield heading, "\n".join(body)
            heading, body = line, []
        elif heading is not None:
            body.append(line)
    if heading is not None:
        yield heading, "\n".join(body)


def check_kinds(root, files):
    for rel in files:
        if classify(rel) is None:
            yield (
                f"{rel}: not a context file, which is README.md, a note (*.md), "
                "goals/*.md, roadmap.toml, or roadmap/*.toml; "
                "move it to docs/ or rename it to one of those kinds"
            )


def check_budgets(root, files):
    readme = root / "README.md"
    if readme.is_file():
        count = words(read(readme))
        if count > ROOT_README_BUDGET:
            yield over("README.md", "README", count, ROOT_README_BUDGET, PROSE_FIX)
    for rel in files:
        kind = classify(rel)
        if kind == "context-readme":
            count = words(read(root / rel))
            if count > CONTEXT_README_BUDGET:
                yield over(rel, "README", count, CONTEXT_README_BUDGET, PROSE_FIX)
        elif kind == "note":
            count = words(read(root / rel))
            if count > NOTE_BUDGET:
                yield over(rel, "note", count, NOTE_BUDGET, PROSE_FIX)
        elif kind == "record":
            for heading, body in record_sections(read(root / rel)):
                for prefix, budget, fix in RECORD_SECTION_BUDGETS:
                    if heading == prefix or heading.startswith(prefix + " "):
                        count = words(body)
                        if count > budget:
                            name = heading[3:].strip()
                            yield over(rel, f"section '{name}'", count, budget, fix)


def parse(root, rel):
    """Returns the TOML file's table, or None if it does not parse.

    check_toml_parses reports the error once; every other check skips the file.
    """
    try:
        return tomllib.loads(read(root / rel))
    except PARSE_ERRORS:
        return None


def goal_files(root, files):
    """Yields (rel, table) for each goal file that parses."""
    for rel in files:
        if classify(rel) == "goal-file":
            data = parse(root, rel)
            if data is not None:
                yield rel, data


def task_tables(data):
    tasks = data.get("tasks", {})
    if not isinstance(tasks, dict):
        return {}
    return {slug: table for slug, table in tasks.items() if isinstance(table, dict)}


def check_toml_parses(root, files):
    for rel in files:
        if classify(rel) not in ("roadmap-index", "goal-file"):
            continue
        try:
            tomllib.loads(read(root / rel))
        except PARSE_ERRORS as error:
            yield f"{rel}: does not parse: {error}; fix the TOML at that position"


def check_index(root, files):
    for rel in files:
        if classify(rel) != "roadmap-index":
            continue
        text = read(root / rel)
        comments = sum(1 for line in text.splitlines() if line.lstrip().startswith("#"))
        if comments > INDEX_COMMENT_LINES:
            yield (
                f"{rel}: {comments} comment lines, at most {INDEX_COMMENT_LINES}; "
                "keep one comment that points to the format"
            )
        data = parse(root, rel)
        if data is None:
            continue
        for key, value in data.items():
            if key not in INDEX_ARRAYS:
                yield (
                    f"{rel}: '{key}' is not one of active, planned, backlog; "
                    "move it into a goal file under context/roadmap/ or remove it"
                )
            elif not isinstance(value, list):
                yield (
                    f"{rel}: '{key}' is not an array; "
                    "write it as an array of goal slugs, [] for none"
                )


def criteria_statements(criteria):
    """Yields (label, statement); a string is one statement, a list is several."""
    if isinstance(criteria, str):
        yield "criteria", criteria
    elif isinstance(criteria, list):
        for i, statement in enumerate(criteria):
            if isinstance(statement, str):
                yield f"criteria[{i}]", statement


def entry_budgets(rel, entry, table, budgets):
    for field, budget in budgets:
        value = table.get(field)
        if isinstance(value, str):
            count = words(value)
            if count > budget:
                yield over(rel, f"{entry} {field}", count, budget, ENTRY_FIX)


def check_entry_budgets(root, files):
    for rel, data in goal_files(root, files):
        yield from entry_budgets(rel, "goal", data, GOAL_ENTRY_BUDGETS)
        for label, statement in criteria_statements(data.get("criteria")):
            count = words(statement)
            if count > CRITERION_BUDGET:
                yield over(rel, f"goal {label}", count, CRITERION_BUDGET, ENTRY_FIX)
        for slug, table in task_tables(data).items():
            yield from entry_budgets(rel, f"tasks.{slug}", table, TASK_ENTRY_BUDGETS)


def check_repos(root, files):
    for rel, data in goal_files(root, files):
        if "repos" not in data:
            yield f"{rel}: repos is missing; every goal file writes it, [] for none"


def is_slug_list(value):
    return isinstance(value, list) and all(isinstance(slug, str) for slug in value)


def check_order(root, files):
    for rel, data in goal_files(root, files):
        slugs = task_tables(data)
        if "order" not in data:
            if slugs:
                yield f"{rel}: order is missing; list each task slug once, in run order"
            continue
        order = data["order"]
        if not is_slug_list(order):
            yield (
                f"{rel}: order is not an array of task slugs; "
                "write it as an array of the task slugs, in run order"
            )
            continue
        seen = set()
        for slug in order:
            if slug in seen:
                yield f"{rel}: order lists '{slug}' more than once; list it once"
            elif slug not in slugs:
                yield (
                    f"{rel}: order lists '{slug}', which has no [tasks.{slug}] table; "
                    f"add a [tasks.{slug}] table or drop it from order"
                )
            seen.add(slug)
        for slug in slugs:
            if slug not in seen:
                yield (
                    f"{rel}: order lacks task '{slug}'; "
                    f"add it to order or drop its [tasks.{slug}] table"
                )


def record_tasks(text):
    """Returns the slugs of the record's ## Tasks list, in order."""
    for heading, body in record_sections(text):
        if heading == "## Tasks":
            return [
                match.group(1)
                for line in body.splitlines()
                if (match := RECORD_TASK.match(line.strip()))
            ]
    return []


def check_record_tasks(root, files):
    present = set(files)
    for rel, data in goal_files(root, files):
        record = Path("context", "goals", rel.stem + ".md")
        if record not in present:
            continue
        order = data.get("order", [])
        if not is_slug_list(order):
            continue
        listed = record_tasks(read(root / record))
        if listed != order:
            yield (
                f"{record}: ## Tasks lists [{', '.join(listed)}], but {rel} "
                f"order is [{', '.join(order)}]; make the list mirror order"
            )


def outside_code(text):
    """Yields (line number, line) for lines outside fenced code, code spans blanked."""
    fence = None
    for number, line in enumerate(text.splitlines(), 1):
        match = FENCE.match(line)
        if fence is None and match:
            fence = match.group(1)
        elif fence is not None:
            if match and match.group(1).startswith(fence):
                fence = None
        else:
            yield number, CODE_SPAN.sub("", line)


def link_targets(text):
    """Yields (line number, target) for each inline link and link definition."""
    for number, line in outside_code(text):
        definition = LINK_DEFINITION.match(line)
        if definition:
            yield number, definition.group(1)
        for match in INLINE_LINK.finditer(line):
            yield number, match.group(1)


def link_path(target):
    """Returns the target's path part, or None if the link is not to a repo path."""
    if target.startswith("<") and target.endswith(">"):
        target = target[1:-1]
    if URL_SCHEME.match(target) or target.startswith("#"):
        return None
    return unquote(re.split(r"[#?]", target, maxsplit=1)[0])


def resolves(root, rel, path):
    """Whether a link path resolves; a /-rooted path is relative to the repo root."""
    if path.startswith("/"):
        return (root / path.lstrip("/")).exists()
    return (root / rel).parent.joinpath(path).exists()


def linking_files(root):
    """Yields the root README and every .md under context/ and docs/, relative."""
    if (root / "README.md").is_file():
        yield Path("README.md")
    for top in ("context", "docs"):
        yield from tree_files(root, top, "*.md")


def check_links(root, files):
    for rel in linking_files(root):
        for number, target in link_targets(read(root / rel)):
            path = link_path(target)
            if path is not None and not resolves(root, rel, path):
                yield (
                    f"{rel}:{number}: link {target} does not resolve; "
                    "point the link at an existing file or remove it"
                )


def capability_entries(lines, start):
    """Yields (line number, opening line, entry lines) for each top-level list item.

    Lines from start up to the next ## heading are the section. A line that is
    neither blank, indented, nor a list item comes back as an entry of its own
    with no opening "- ", so the check reports it as not an entry.
    """
    entry = None
    for number in range(start, len(lines) + 1):
        line = lines[number - 1]
        if line.startswith("## "):
            break
        if line.startswith("- ") or (line.strip() and not line[0].isspace()):
            if entry is not None:
                yield entry
            entry = (number, line, [number])
        elif entry is not None:
            entry[2].append(number)
        elif line.strip():
            yield number, line, [number]
    if entry is not None:
        yield entry


def check_capability_map(root, files):
    rel = Path("context", "README.md")
    if not (root / rel).is_file():
        return
    text = read(root / rel)
    lines = text.splitlines()
    if CAPABILITY_MAP not in lines:
        yield (
            f"{rel}: no '{CAPABILITY_MAP}' heading; add one listing each feature "
            "as built or planned"
        )
        return
    targets = {}
    for number, target in link_targets(text):
        if link_path(target) is not None:
            targets.setdefault(number, []).append(target)
    start = lines.index(CAPABILITY_MAP) + 2
    for number, line, entry_lines in capability_entries(lines, start):
        if not line.startswith("- "):
            yield f"{rel}:{number}: capability map line is not an entry; {ENTRY_FORM}"
            continue
        match = CAPABILITY_ENTRY.match(line)
        if match is None:
            named = CAPABILITY_NAME.match(line)
            name = f"'{named.group(1)}'" if named else "without a bold name"
            yield f"{rel}:{number}: capability map entry {name}: {ENTRY_FORM}"
            continue
        name, status = match.groups()
        if status == "built" and not any(n in targets for n in entry_lines):
            yield (
                f"{rel}:{number}: capability map entry '{name}' is built but links "
                "nothing; link its home with a relative link"
            )


CHECKS = (
    check_kinds,
    check_budgets,
    check_toml_parses,
    check_index,
    check_entry_budgets,
    check_repos,
    check_order,
    check_record_tasks,
    check_capability_map,
    check_links,
)


def main():
    root = Path.cwd()
    files = list(tree_files(root, "context"))
    failures = [line for check in CHECKS for line in check(root, files)]
    for line in failures:
        print(line)
    return 1 if failures else 0


if __name__ == "__main__":
    sys.exit(main())
