#!/usr/bin/env bash
# A shim for the marathon Go command this file is named after, run in the caller's working
# directory with the caller's arguments. It runs the plugin's local build, .build/ beside bin/,
# when that holds the command, as claude-plugins' scripts/build.sh makes it. Otherwise it runs the
# command from the marathon/v<version> release of standards-lab/claude-plugins through mise exec,
# at the plugin's own version, ignoring every project mise config so the caller's repository can't
# change or break it.
set -euo pipefail

version=0.20.0

name=$(basename "$0")
local_build=$(dirname "$0")/../.build/$name
if [ -x "$local_build" ]; then
  exec "$local_build" "$@"
fi
MISE_OVERRIDE_CONFIG_FILENAMES=no-project-config exec mise exec \
  "github:standards-lab/claude-plugins[version_prefix=marathon/v]@$version" -- "$name" "$@"
