#!/usr/bin/env python3
"""Check a marathon repository's context at the current working directory.

Every file under context/ is of a known kind: the context README, a note, a
goal record, the roadmap index, or a goal file. Notes, READMEs, goal-record
sections, and roadmap entries stay within fixed word budgets, where a word is a
whitespace-separated token, as wc -w counts it. The roadmap keeps the shape
marathon's references/manifest.md gives it. Prints one line per failure and
exits nonzero if there is any.
"""

import re
import sys
import tomllib
from pathlib import Path

CONTEXT_README_BUDGET = 1000
ROOT_README_BUDGET = 1500
NOTE_BUDGET = 1500
RECORD_SECTION_BUDGETS = (
    ("## Task brief", 1200, "shorten"),
    ("## Decisions", 2000, "prune what no longer binds later tasks"),
    ("## Pending edits", 1000, "apply or shorten"),
)
PROSE_FIX = "trim; move detail to docs/"
INDEX_ARRAYS = ("active", "planned", "backlog")
INDEX_COMMENT_LINES = 2
GOAL_ENTRY_BUDGETS = (("summary", 100),)
TASK_ENTRY_BUDGETS = (("summary", 100), ("proof", 40))
CRITERION_BUDGET = 60
ENTRY_FIX = "move detail to the goal's context note"
PARSE_ERRORS = (tomllib.TOMLDecodeError, UnicodeDecodeError)
RECORD_TASK = re.compile(r"\d+\. \[[ x]\] (\S+)$")


def words(text):
    return len(text.split())


def over(path, kind, count, budget, fix):
    return f"{path}: {kind} is {count:,} words, budget {budget:,}; {fix}"


def classify(rel):
    """Returns the kind of a path relative to the root, or None if it has none."""
    parts = rel.parts
    if parts == ("context", "README.md"):
        return "context-readme"
    if parts == ("context", "roadmap.toml"):
        return "roadmap-index"
    if len(parts) == 2 and rel.suffix == ".md":
        return "note"
    if len(parts) == 3 and parts[1] == "goals" and rel.suffix == ".md":
        return "record"
    if len(parts) == 3 and parts[1] == "roadmap" and rel.suffix == ".toml":
        return "goal-file"
    return None


def context_files(root):
    """Yields every file under context/, skipping dotfiles and dot directories."""
    context = root / "context"
    if not context.is_dir():
        return
    for path in sorted(context.rglob("*")):
        rel = path.relative_to(root)
        if any(part.startswith(".") for part in rel.parts):
            continue
        if path.is_file():
            yield rel


def record_sections(text):
    """Yields (heading, body) for each ## section; the heading is not in the body."""
    heading, body = None, []
    for line in text.splitlines():
        if line.startswith("## "):
            if heading is not None:
                yield heading, "\n".join(body)
            heading, body = line, []
        elif heading is not None:
            body.append(line)
    if heading is not None:
        yield heading, "\n".join(body)


def check_kinds(root, files):
    for rel in files:
        if classify(rel) is None:
            yield (
                f"{rel}: not a context file; context/ holds only README.md, "
                "notes (*.md), goals/*.md, roadmap.toml, and roadmap/*.toml"
            )


def check_budgets(root, files):
    readme = root / "README.md"
    if readme.is_file():
        count = words(readme.read_text())
        if count > ROOT_README_BUDGET:
            yield over("README.md", "README", count, ROOT_README_BUDGET, PROSE_FIX)
    for rel in files:
        kind = classify(rel)
        if kind == "context-readme":
            count = words((root / rel).read_text())
            if count > CONTEXT_README_BUDGET:
                yield over(rel, "README", count, CONTEXT_README_BUDGET, PROSE_FIX)
        elif kind == "note":
            count = words((root / rel).read_text())
            if count > NOTE_BUDGET:
                yield over(rel, "note", count, NOTE_BUDGET, PROSE_FIX)
        elif kind == "record":
            for heading, body in record_sections((root / rel).read_text()):
                for prefix, budget, fix in RECORD_SECTION_BUDGETS:
                    if heading == prefix or heading.startswith(prefix + " "):
                        count = words(body)
                        if count > budget:
                            name = heading[3:].strip()
                            yield over(rel, f"section '{name}'", count, budget, fix)


def parse(root, rel):
    """Returns the TOML file's table, or None if it does not parse.

    check_toml_parses reports the error once; every other check skips the file.
    """
    try:
        return tomllib.loads((root / rel).read_text())
    except PARSE_ERRORS:
        return None


def goal_files(root, files):
    """Yields (rel, table) for each goal file that parses."""
    for rel in files:
        if classify(rel) == "goal-file":
            data = parse(root, rel)
            if data is not None:
                yield rel, data


def task_tables(data):
    tasks = data.get("tasks", {})
    if not isinstance(tasks, dict):
        return {}
    return {slug: table for slug, table in tasks.items() if isinstance(table, dict)}


def check_toml_parses(root, files):
    for rel in files:
        if classify(rel) not in ("roadmap-index", "goal-file"):
            continue
        try:
            tomllib.loads((root / rel).read_text())
        except PARSE_ERRORS as error:
            yield f"{rel}: does not parse: {error}"


def check_index(root, files):
    for rel in files:
        if classify(rel) != "roadmap-index":
            continue
        text = (root / rel).read_text()
        comments = sum(1 for line in text.splitlines() if line.lstrip().startswith("#"))
        if comments > INDEX_COMMENT_LINES:
            yield (
                f"{rel}: {comments} comment lines, at most {INDEX_COMMENT_LINES}; "
                "keep one comment that points to the format"
            )
        data = parse(root, rel)
        if data is None:
            continue
        for key, value in data.items():
            if key not in INDEX_ARRAYS:
                yield (
                    f"{rel}: '{key}' is not one of active, planned, backlog; "
                    "the index holds only the three arrays"
                )
            elif not isinstance(value, list):
                yield f"{rel}: '{key}' is not an array"


def criteria_statements(criteria):
    """Yields (label, statement); a string is one statement, a list is several."""
    if isinstance(criteria, str):
        yield "criteria", criteria
    elif isinstance(criteria, list):
        for i, statement in enumerate(criteria):
            if isinstance(statement, str):
                yield f"criteria[{i}]", statement


def entry_budgets(rel, entry, table, budgets):
    for field, budget in budgets:
        value = table.get(field)
        if isinstance(value, str):
            count = words(value)
            if count > budget:
                yield over(rel, f"{entry} {field}", count, budget, ENTRY_FIX)


def check_entry_budgets(root, files):
    for rel, data in goal_files(root, files):
        yield from entry_budgets(rel, "goal", data, GOAL_ENTRY_BUDGETS)
        for label, statement in criteria_statements(data.get("criteria")):
            count = words(statement)
            if count > CRITERION_BUDGET:
                yield over(rel, f"goal {label}", count, CRITERION_BUDGET, ENTRY_FIX)
        for slug, table in task_tables(data).items():
            yield from entry_budgets(rel, f"tasks.{slug}", table, TASK_ENTRY_BUDGETS)


def check_repos(root, files):
    for rel, data in goal_files(root, files):
        if "repos" not in data:
            yield f"{rel}: repos is missing; every goal file writes it, [] for none"


def is_slug_list(value):
    return isinstance(value, list) and all(isinstance(slug, str) for slug in value)


def check_order(root, files):
    for rel, data in goal_files(root, files):
        slugs = task_tables(data)
        if "order" not in data:
            if slugs:
                yield f"{rel}: order is missing; list each task slug once, in run order"
            continue
        order = data["order"]
        if not is_slug_list(order):
            yield f"{rel}: order is not an array of task slugs"
            continue
        seen = set()
        for slug in order:
            if slug in seen:
                yield f"{rel}: order lists '{slug}' more than once"
            elif slug not in slugs:
                yield f"{rel}: order lists '{slug}', which has no [tasks.{slug}] table"
            seen.add(slug)
        for slug in slugs:
            if slug not in seen:
                yield f"{rel}: order lacks task '{slug}'"


def record_tasks(text):
    """Returns the slugs of the record's ## Tasks list, in order."""
    for heading, body in record_sections(text):
        if heading == "## Tasks":
            return [
                match.group(1)
                for line in body.splitlines()
                if (match := RECORD_TASK.match(line.strip()))
            ]
    return []


def check_record_tasks(root, files):
    present = set(files)
    for rel, data in goal_files(root, files):
        record = Path("context", "goals", rel.stem + ".md")
        if record not in present:
            continue
        order = data.get("order", [])
        if not is_slug_list(order):
            continue
        listed = record_tasks((root / record).read_text())
        if listed != order:
            yield (
                f"{record}: ## Tasks lists [{', '.join(listed)}], but {rel} "
                f"order is [{', '.join(order)}]; make the list mirror order"
            )


CHECKS = (
    check_kinds,
    check_budgets,
    check_toml_parses,
    check_index,
    check_entry_budgets,
    check_repos,
    check_order,
    check_record_tasks,
)


def main():
    root = Path.cwd()
    files = list(context_files(root))
    failures = [line for check in CHECKS for line in check(root, files)]
    for line in failures:
        print(line)
    return 1 if failures else 0


if __name__ == "__main__":
    sys.exit(main())
